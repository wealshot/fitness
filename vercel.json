{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/rodionov",
      "destination": "/radionov",
      "permanent": true
    },
    {
      "source": "/rodionov/admin",
      "destination": "/radionov/admin",
      "permanent": true
    }
  ]
}